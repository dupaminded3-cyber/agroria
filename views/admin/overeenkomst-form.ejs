<%- include('_head', { titel: overeenkomst ? 'Overeenkomst bewerken' : 'Overeenkomst opstellen' }) %>
<%- include('_side') %>
<%
  // Startwaarden: bij een nieuwe overeenkomst alvast slim ingevuld
  // (vandaag, en — indien gekozen — de gegevens van een trekker of factuur).
  var vandaag = new Date().toISOString().slice(0,10);
  var o = overeenkomst || {
    nummer: voorstelNummer,
    datum: vandaag,
    plaats: plaatsStandaard || '',
    status: 'concept',
    klant: {}, machine: {}, machines: [], regels: [],
    prijsType: 'marge', aanbetaling: 0, aanbetalingVervalt: '',
    betalingMoment: 'bij_levering', betalingUiterlijk: '',
    leverdatum: '', levering: '', bezichtigd: false,
    inruil: { actief: false },
    importLand: '', bijzonderheden: '',
    bank: bank || {}
  };
  if (!overeenkomst && vanFactuur) {
    o.klant = vanFactuur.klant || {};
    o.machines = documentMachines(vanFactuur);
    o.machine = o.machines[0] || {};
    o.regels = vanFactuur.regels || [];
    o.prijsType = vanFactuur.prijsType || 'marge';
    o.aanbetaling = vanFactuur.aanbetaling || 0;
    o.aanbetalingVervalt = vanFactuur.aanbetalingVervalt || '';
    o.levering = vanFactuur.levering || '';
    o.bank = vanFactuur.bank || bank || {};
  } else if (!overeenkomst && trekker) {
    o.machines = [{
      naam: (trekker.merk + ' ' + trekker.model).trim(),
      bouwjaar: trekker.bouwjaar || '', uren: trekker.uren || '',
      pk: trekker.pk || '', transmissie: trekker.transmissie || '',
      serienummer: '', kenteken: ''
    }];
    o.machine = o.machines[0];
    o.prijsType = (trekker.prijsType === 'btw' || trekker.prijsType === 'netto') ? trekker.prijsType : 'marge';
    o.regels = [{ omschrijving: 'Koopsom ' + trekker.merk + ' ' + trekker.model + ' (rijklaar geleverd)', bedrag: trekker.prijs || 0 }];
  }
  var machines = documentMachines(o);
  if (!machines.length) machines = [{ naam:'', bouwjaar:'', uren:'', pk:'', transmissie:'', serienummer:'', kenteken:'' }];
  var ob = o.bank || bank || {};
  var inruil = o.inruil || { actief: false };
  function invoerBedrag(n){
    n = Number(n || 0);
    if (!n) return '';
    return (Math.round(n * 100) / 100).toFixed(2).replace('.', ',');
  }
  var trekkerKeuze = (trekkers || []).map(function(t){
    return {
      id: t.id,
      naam: (t.merk + ' ' + t.model).trim(),
      bouwjaar: t.bouwjaar || '',
      uren: t.uren || '',
      pk: t.pk || '',
      transmissie: t.transmissie || '',
      prijs: t.prijs || 0,
      prijsType: (t.prijsType === 'btw' || t.prijsType === 'netto') ? t.prijsType : 'marge',
      label: t.merk + ' ' + t.model + ' (' + (t.bouwjaar || '—') + ') — ' + euro(t.prijs)
    };
  });
%>
<div class="topbar">
  <div><h1><%= overeenkomst ? 'Overeenkomst bewerken' : 'Nieuwe koopovereenkomst' %></h1>
    <div class="sub"><a href="/uadmin/overeenkomsten" style="color:var(--muted)">← Terug naar overeenkomsten</a></div></div>
  <% if (overeenkomst) { %>
    <div style="display:flex;gap:10px">
      <a class="btn btn-out" href="/uadmin/facturen/nieuw?overeenkomst=<%= overeenkomst.id %>" title="Maak de bijbehorende factuur — alle gegevens en de verwijzing naar deze overeenkomst worden overgenomen">Maak factuur</a>
      <a class="btn btn-fill" href="/uadmin/overeenkomsten/<%= overeenkomst.id %>/print" target="_blank">Bekijk / opslaan als PDF ↗</a>
    </div>
  <% } %>
</div>

<% if (typeof opgeslagen !== 'undefined' && opgeslagen) { %>
  <div class="melding ok">Overeenkomst opgeslagen. Klik rechtsboven op <b>"Bekijk / opslaan als PDF"</b> voor het opgemaakte document.</div>
<% } %>

<form method="post" action="/uadmin/overeenkomsten<%= overeenkomst ? '/'+overeenkomst.id : '' %>">

<div class="panel" style="padding:28px;margin-bottom:20px">
  <h3 style="font-family:var(--display);font-weight:600;margin-bottom:18px">Overeenkomst</h3>
  <div class="formgrid">
    <div class="field"><label>Nummer</label><input name="nummer" value="<%= o.nummer %>" required></div>
    <div class="field"><label>Status</label>
      <select name="status">
        <option value="concept" <%= o.status==='concept'?'selected':'' %>>Concept</option>
        <option value="getekend" <%= o.status==='getekend'?'selected':'' %>>Getekend</option>
      </select>
    </div>
    <div class="field"><label>Datum overeenkomst</label><input type="date" name="datum" value="<%= o.datum %>" required></div>
    <div class="field"><label>Plaats van ondertekening</label><input name="plaats" value="<%= o.plaats %>" placeholder="Bijv. Utrecht"></div>
  </div>
</div>

<div class="panel" style="padding:28px;margin-bottom:20px">
  <h3 style="font-family:var(--display);font-weight:600;margin-bottom:18px">Koper</h3>
  <div class="formgrid">
    <div class="field"><label>Naam</label><input name="klant_naam" value="<%= o.klant.naam || '' %>" placeholder="Bijv. J. van den Berg" required></div>
    <div class="field"><label>Bedrijfsnaam — optioneel</label><input name="klant_bedrijf" value="<%= o.klant.bedrijf || '' %>" placeholder="Bijv. Maatschap Van den Berg"></div>
    <div class="field"><label>Adres</label><input name="klant_adres" value="<%= o.klant.adres || '' %>" placeholder="Straat en huisnummer"></div>
    <div class="field"><label>Postcode en plaats</label><input name="klant_postcodeplaats" value="<%= o.klant.postcodePlaats || '' %>" placeholder="1234 AB Plaatsnaam"></div>
    <div class="field"><label>Land — optioneel</label><input name="klant_land" value="<%= o.klant.land || '' %>" placeholder="Nederland / België / Duitsland"></div>
    <div class="field"><label>E-mail — optioneel</label><input name="klant_email" value="<%= o.klant.email || '' %>"></div>
    <div class="field"><label>Telefoon — optioneel</label><input name="klant_telefoon" value="<%= o.klant.telefoon || '' %>"></div>
    <div class="field"><label>KvK-nummer koper — optioneel</label><input name="klant_kvk" value="<%= o.klant.kvk || '' %>"></div>
    <div class="field"><label>BTW-nummer koper — optioneel</label><input name="klant_btw" value="<%= o.klant.btw || '' %>"></div>
  </div>
</div>

<div class="panel" style="padding:28px;margin-bottom:20px">
  <div style="margin-bottom:10px">
    <h3 style="font-family:var(--display);font-weight:600;margin:0 0 6px">Machines</h3>
    <div class="hint">Je kunt één of meerdere trekkers op dezelfde koopovereenkomst zetten. Kies uit het aanbod of vul handmatig in.</div>
  </div>
  <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:18px;padding:14px 16px;background:#f7f5f0;border:1px solid var(--line);border-radius:12px">
    <b style="font-size:.9rem">Trekker uit aanbod toevoegen:</b>
    <select id="trekkerKiezer" style="border:1px solid var(--line);border-radius:8px;padding:9px 12px;font-family:inherit;font-size:.9rem;background:#fff;min-width:260px">
      <option value="">— kies een trekker —</option>
      <% trekkerKeuze.forEach(function(t){ %>
        <option value="<%= t.id %>"><%= t.label %></option>
      <% }) %>
    </select>
    <button class="btn btn-out btn-sm" type="button" id="trekkerErbij">+ Toevoegen aan overeenkomst</button>
  </div>
  <div id="machines">
    <% machines.forEach(function(m, idx){ %>
      <div class="machine-blok" style="border:1px solid var(--line);border-radius:12px;padding:18px;margin-bottom:12px;background:#fff">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
          <b style="font-size:.92rem">Machine <span class="machine-nr"><%= idx + 1 %></span></b>
          <button type="button" class="btn btn-danger btn-sm machine-weg" title="Machine verwijderen">×</button>
        </div>
        <div class="formgrid">
          <div class="field"><label>Merk en model</label><input name="machine_naam" value="<%= m.naam || '' %>" placeholder="Bijv. Fendt 716 Vario"></div>
          <div class="field"><label>Bouwjaar</label><input name="machine_bouwjaar" value="<%= m.bouwjaar || '' %>" placeholder="2004"></div>
          <div class="field"><label>Draaiuren</label><input name="machine_uren" value="<%= m.uren || '' %>" placeholder="8450"></div>
          <div class="field"><label>Vermogen (pk)</label><input name="machine_pk" value="<%= m.pk || '' %>" placeholder="160"></div>
          <div class="field"><label>Transmissie</label><input name="machine_transmissie" value="<%= m.transmissie || '' %>" placeholder="Vario / Powershift …"></div>
          <div class="field"><label>Serie-/chassisnummer — optioneel</label><input name="machine_serienummer" value="<%= m.serienummer || '' %>"><div class="hint">Sterk aan te raden: dit legt vast om wélke machine het gaat.</div></div>
          <div class="field"><label>Kenteken — optioneel</label><input name="machine_kenteken" value="<%= m.kenteken || '' %>"></div>
        </div>
      </div>
    <% }) %>
  </div>
  <button type="button" class="btn btn-out btn-sm" id="machineErbij">+ Lege machine toevoegen</button>
</div>

<div class="panel" style="padding:28px;margin-bottom:20px">
  <h3 style="font-family:var(--display);font-weight:600;margin-bottom:6px">Koopsom</h3>
  <div class="hint" style="margin-bottom:16px">Per trekker komt er automatisch een regel bij. Een korting vul je in als <b>negatief</b> bedrag, bijv. <code>-1500</code>. Voor een <b>inruil</b> gebruik je het aparte blok hieronder — die waarde wordt automatisch van de koopsom afgetrokken.</div>
  <div id="regels">
    <% (o.regels.length ? o.regels : [{omschrijving:'',bedrag:''}]).forEach(function(r){ %>
      <div class="regel" style="display:flex;gap:12px;margin-bottom:10px">
        <input name="regel_omschrijving" value="<%= r.omschrijving %>" placeholder="Omschrijving — bijv. Koopsom Fendt 716 Vario (rijklaar geleverd)" style="flex:1;border:1px solid var(--line);border-radius:9px;padding:12px 13px;font-family:var(--body);font-size:.94rem">
        <input name="regel_bedrag" value="<%= typeof r.bedrag === 'number' ? invoerBedrag(r.bedrag) : r.bedrag %>" placeholder="Bedrag in €" style="width:170px;border:1px solid var(--line);border-radius:9px;padding:12px 13px;font-family:var(--body);font-size:.94rem;text-align:right">
        <button type="button" class="btn btn-danger btn-sm regel-weg" title="Regel verwijderen">×</button>
      </div>
    <% }) %>
  </div>
  <button type="button" class="btn btn-out btn-sm" id="regelErbij">+ Regel toevoegen</button>

  <div class="formgrid" style="margin-top:22px">
    <div class="field full">
      <label>Prijsregeling</label>
      <select name="prijsType" id="prijsType">
        <option value="marge" <%= (!o.prijsType || o.prijsType==='marge')?'selected':'' %>>Margeregeling — bedragen zijn totaalprijzen, BTW niet apart vermeld (gebruikte machines)</option>
        <option value="btw" <%= o.prijsType==='btw'?'selected':'' %>>BTW-regeling — bedragen zijn excl. BTW; 21% BTW wordt apart vermeld</option>
        <option value="netto" <%= o.prijsType==='netto'?'selected':'' %>>Netto — geen Nederlandse BTW (bijv. Belgische/EU-klanten)</option>
      </select>
      <div class="hint">
        <b>BTW-regeling</b>: 21% NL-BTW apart. <b>Margeregeling</b>: BTW zit in de prijs. <b>Netto</b>: geen Nederlandse BTW — geschikt als de koper in België/EU geen NL-belasting betaalt (vul bij voorkeur het BTW-nummer van de koper in).
      </div>
    </div>
    <div class="field full">
      <label>Betaalmoment</label>
      <select name="betaling_moment" id="betalingMoment">
        <option value="bij_levering" <%= o.betalingMoment!=='voor_levering'?'selected':'' %>>Betaling bij levering — koopsom (of restant) uiterlijk bij aflevering</option>
        <option value="voor_levering" <%= o.betalingMoment==='voor_levering'?'selected':'' %>>Betaling vóór levering — koopsom (of restant) moet binnen zijn vóór aflevering</option>
      </select>
      <div class="hint">Dit bepaalt de tekst in artikel “Koopsom en betaling”. Met een aanbetaling geldt dit moment voor het <b>restant</b>.</div>
    </div>
    <div class="field" id="betalingUiterlijkVeld" style="<%= o.betalingMoment==='voor_levering'?'':'display:none' %>">
      <label>Uiterste betaaldatum — optioneel</label>
      <input type="date" name="betaling_uiterlijk" value="<%= o.betalingUiterlijk || '' %>">
      <div class="hint">Alleen bij betaling vóór levering: komt als “uiterlijk …” in de overeenkomst.</div>
    </div>
    <div class="field"><label>Aanbetaling — optioneel</label><input name="aanbetaling" value="<%= invoerBedrag(o.aanbetaling) %>" placeholder="Bijv. 5000"><div class="hint">Vul je een aanbetaling in, dan komt er een betaalschema: aanbetaling + restant. Het restant volgt het gekozen betaalmoment hierboven.</div></div>
    <div class="field"><label>Aanbetaling uiterlijk</label><input type="date" name="aanbetaling_vervalt" value="<%= o.aanbetalingVervalt %>"></div>
    <div class="field"><label>IBAN</label><input name="bank_iban" value="<%= ob.iban || '' %>" placeholder="NL00 BANK 0123 4567 89"></div>
    <div class="field"><label>BIC — optioneel</label><input name="bank_bic" value="<%= ob.bic || '' %>" placeholder="INGBNL2A"></div>
    <div class="field"><label>Ten name van</label><input name="bank_tnv" value="<%= ob.tnv || '' %>" placeholder="Agroria Landbouwvoertuigen"></div>
  </div>
</div>

<div class="panel" style="padding:28px;margin-bottom:20px">
  <h3 style="font-family:var(--display);font-weight:600;margin-bottom:6px">Inruil</h3>
  <div class="hint" style="margin-bottom:16px">Heeft de klant een trekker in te ruilen? Zet dit op <b>Ja</b>, vul de machine in en de overeengekomen inruilwaarde. Die waarde wordt van de koopsom afgehaald en komt apart op de overeenkomst te staan.</div>
  <div class="formgrid">
    <div class="field full"><label>Met inruil?</label>
      <select name="inruil_actief" id="inruilActief">
        <option value="nee" <%= !inruil.actief ? 'selected':'' %>>Nee — geen inruil</option>
        <option value="ja" <%= inruil.actief ? 'selected':'' %>>Ja — klant ruilt een trekker in</option>
      </select>
    </div>
  </div>
  <div id="inruilVelden" style="<%= inruil.actief ? '' : 'display:none' %>">
    <div class="formgrid" style="margin-top:8px">
      <div class="field"><label>Merk en model inruiltrekker</label><input name="inruil_naam" value="<%= inruil.naam || '' %>" placeholder="Bijv. John Deere 6920"></div>
      <div class="field"><label>Inruilwaarde (€)</label><input name="inruil_waarde" value="<%= inruil.waarde ? invoerBedrag(inruil.waarde) : '' %>" placeholder="Bijv. 12500"><div class="hint">Vul een positief bedrag in — wij trekken dit automatisch van de koopsom af.</div></div>
      <div class="field"><label>Bouwjaar</label><input name="inruil_bouwjaar" value="<%= inruil.bouwjaar || '' %>" placeholder="2004"></div>
      <div class="field"><label>Draaiuren</label><input name="inruil_uren" value="<%= inruil.uren || '' %>" placeholder="8450"></div>
      <div class="field"><label>Vermogen (pk)</label><input name="inruil_pk" value="<%= inruil.pk || '' %>" placeholder="160"></div>
      <div class="field"><label>Transmissie</label><input name="inruil_transmissie" value="<%= inruil.transmissie || '' %>" placeholder="Powershift / Vario …"></div>
      <div class="field"><label>Serie-/chassisnummer — optioneel</label><input name="inruil_serienummer" value="<%= inruil.serienummer || '' %>"></div>
      <div class="field"><label>Kenteken — optioneel</label><input name="inruil_kenteken" value="<%= inruil.kenteken || '' %>"></div>
    </div>
  </div>
</div>

<div class="panel" style="padding:28px;margin-bottom:20px">
  <h3 style="font-family:var(--display);font-weight:600;margin-bottom:18px">Levering en bijzonderheden</h3>
  <div class="formgrid">
    <div class="field"><label>Beoogde leverdatum — optioneel</label><input type="date" name="leverdatum" value="<%= o.leverdatum %>"><div class="hint">Komt als indicatieve leverdatum in het leveringsartikel te staan.</div></div>
    <div class="field"><label>Vooraf bezichtigd?</label>
      <select name="bezichtigd">
        <option value="nee" <%= !o.bezichtigd ? 'selected':'' %>>Nee — aankoop op afstand (14 dagen bedenktijd)</option>
        <option value="ja" <%= o.bezichtigd ? 'selected':'' %>>Ja — koper heeft vooraf bezichtigd (geen bedenktijd)</option>
      </select>
      <div class="hint">Standaard “Nee”: koper krijgt 14 dagen bedenktijd na levering (max. 20 werkuren, retourtransport voor Agroria). Alleen “Ja” als de koper de machine(s) écht vooraf heeft bezichtigd of beproefd.</div>
    </div>
    <div class="field"><label>Herkomst machine</label>
      <select name="import_land">
        <option value="" <%= !o.importLand ? 'selected':'' %>>Al in Nederland (geen grensoverschrijdende import)</option>
        <option value="Duitsland" <%= o.importLand==='Duitsland' ? 'selected':'' %>>Duitsland</option>
        <option value="België" <%= o.importLand==='België' ? 'selected':'' %>>België</option>
      </select>
    </div>
    <div class="field"><label>Bestemming / registratieland</label>
      <% const bestemming = o.bestemmingLand || 'Nederland'; %>
      <select name="bestemming_land">
        <option value="Nederland" <%= bestemming==='Nederland' ? 'selected':'' %>>Nederland (RDW)</option>
        <option value="België" <%= bestemming==='België' ? 'selected':'' %>>België (DIV)</option>
        <option value="Duitsland" <%= bestemming==='Duitsland' ? 'selected':'' %>>Duitsland (Zulassung)</option>
      </select>
      <div class="hint">Agroria verzorgt altijd het volledige traject (uitvoer/invoer + registratie in het bestemmingsland). Leverdatum is indicatief zodra RDW, DIV of Zulassungsstelle moet meewerken. De juiste tekst verschijnt automatisch in de overeenkomst.</div>
    </div>
    <div class="field full"><label>Extra leveringsafspraak — optioneel</label><textarea name="levering" rows="2" placeholder="Bijv.: Levering inclusief frontgewicht en tweede set gewichten, zoals bezichtigd."><%= o.levering %></textarea></div>
    <div class="field full"><label>Bijzondere afspraken — optioneel</label><textarea name="bijzonderheden" rows="3" placeholder="Bijv.: Vóór levering wordt een volledige onderhoudsbeurt uitgevoerd, inclusief nieuwe filters en olie."><%= o.bijzonderheden %></textarea><div class="hint">Komt als apart artikel "Bijzondere afspraken" in de overeenkomst.</div></div>
  </div>
</div>

<div class="formactions" style="margin-bottom:34px">
  <button class="btn btn-fill" type="submit"><%= overeenkomst ? 'Wijzigingen opslaan' : 'Overeenkomst opslaan' %></button>
  <a class="btn btn-out" href="/uadmin/overeenkomsten">Annuleren</a>
</div>
</form>

<script>
  window.__AGRORIA_TREKKERS__ = <%- safeJsonLd(trekkerKeuze) %>;
  window.__AGRORIA_REGEL_PREFIX__ = 'Koopsom';
</script>
<script>
  (function(){
    function nummerMachines(){
      var blokken = document.querySelectorAll('#machines .machine-blok');
      blokken.forEach(function(blok, i){
        var nr = blok.querySelector('.machine-nr');
        if (nr) nr.textContent = String(i + 1);
      });
    }

    function leegMachineBlok(){
      var houder = document.getElementById('machines');
      var eerste = houder.querySelector('.machine-blok');
      var kopie = eerste.cloneNode(true);
      kopie.querySelectorAll('input').forEach(function(i){ i.value = ''; });
      return kopie;
    }

    function vulMachineBlok(blok, data){
      var map = {
        machine_naam: data.naam || '',
        machine_bouwjaar: data.bouwjaar || '',
        machine_uren: data.uren || '',
        machine_pk: data.pk || '',
        machine_transmissie: data.transmissie || '',
        machine_serienummer: data.serienummer || '',
        machine_kenteken: data.kenteken || ''
      };
      Object.keys(map).forEach(function(naam){
        var veld = blok.querySelector('input[name="' + naam + '"]');
        if (veld) veld.value = map[naam];
      });
    }

    function voegRegelToe(omschrijving, bedrag){
      var houder = document.getElementById('regels');
      var eerste = houder.querySelector('.regel');
      var kopie = eerste.cloneNode(true);
      var velden = kopie.querySelectorAll('input');
      velden[0].value = omschrijving || '';
      velden[1].value = bedrag || '';
      var bestaande = houder.querySelectorAll('.regel');
      if (bestaande.length === 1) {
        var b0 = bestaande[0].querySelectorAll('input');
        if (!b0[0].value && !b0[1].value) {
          b0[0].value = omschrijving || '';
          b0[1].value = bedrag || '';
          return;
        }
      }
      houder.appendChild(kopie);
    }

    function bedragVoorInvoer(n){
      n = Number(n || 0);
      if (!n) return '';
      return (Math.round(n * 100) / 100).toFixed(2).replace('.', ',');
    }

    var wasLeeg = (function(){
      var naam = document.querySelector('#machines input[name="machine_naam"]');
      return !naam || !naam.value.trim();
    })();

    document.getElementById('machineErbij').addEventListener('click', function(){
      document.getElementById('machines').appendChild(leegMachineBlok());
      nummerMachines();
    });

    document.getElementById('machines').addEventListener('click', function(e){
      var knop = e.target.closest('.machine-weg');
      if (!knop) return;
      var houder = document.getElementById('machines');
      var blokken = houder.querySelectorAll('.machine-blok');
      if (blokken.length <= 1) {
        blokken[0].querySelectorAll('input').forEach(function(i){ i.value = ''; });
        return;
      }
      knop.closest('.machine-blok').remove();
      nummerMachines();
    });

    document.getElementById('trekkerErbij').addEventListener('click', function(){
      var keuze = document.getElementById('trekkerKiezer').value;
      if (!keuze) return;
      var t = (window.__AGRORIA_TREKKERS__ || []).find(function(x){ return x.id === keuze; });
      if (!t) return;
      var houder = document.getElementById('machines');
      var blokken = houder.querySelectorAll('.machine-blok');
      var doel = null;
      if (blokken.length === 1) {
        var naamVeld = blokken[0].querySelector('input[name="machine_naam"]');
        if (naamVeld && !naamVeld.value.trim()) doel = blokken[0];
      }
      if (!doel) {
        doel = leegMachineBlok();
        houder.appendChild(doel);
      }
      vulMachineBlok(doel, t);
      nummerMachines();
      voegRegelToe(
        (window.__AGRORIA_REGEL_PREFIX__ || 'Koopsom') + ' ' + t.naam + ' (rijklaar geleverd)',
        bedragVoorInvoer(t.prijs)
      );
      var prijsType = document.getElementById('prijsType');
      if (prijsType && wasLeeg) prijsType.value = t.prijsType || 'marge';
      wasLeeg = false;
      document.getElementById('trekkerKiezer').value = '';
    });

    var houder = document.getElementById('regels');
    document.getElementById('regelErbij').addEventListener('click', function(){
      var eerste = houder.querySelector('.regel');
      var kopie = eerste.cloneNode(true);
      kopie.querySelectorAll('input').forEach(function(i){ i.value=''; });
      houder.appendChild(kopie);
    });
    houder.addEventListener('click', function(e){
      var knop = e.target.closest('.regel-weg');
      if (!knop) return;
      var regels = houder.querySelectorAll('.regel');
      if (regels.length <= 1) {
        regels[0].querySelectorAll('input').forEach(function(i){ i.value=''; });
        return;
      }
      knop.closest('.regel').remove();
    });
  })();
</script>
<script>
  (function(){
    var keuze = document.getElementById('betalingMoment');
    var veld = document.getElementById('betalingUiterlijkVeld');
    if (!keuze || !veld) return;
    function sync(){
      veld.style.display = keuze.value === 'voor_levering' ? '' : 'none';
    }
    keuze.addEventListener('change', sync);
    sync();
  })();
</script>
<script>
  (function(){
    var keuze = document.getElementById('inruilActief');
    var velden = document.getElementById('inruilVelden');
    if (!keuze || !velden) return;
    function sync(){
      velden.style.display = keuze.value === 'ja' ? '' : 'none';
    }
    keuze.addEventListener('change', sync);
    sync();
  })();
</script>
