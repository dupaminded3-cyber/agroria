<%- include('_head', { titel: factuur ? 'Factuur bewerken' : 'Factuur maken' }) %>
<%- include('_side') %>
<%
  // Startwaarden: bij een nieuwe factuur alvast slim ingevuld (vandaag,
  // vervaldatum over 14 dagen, en — indien gekozen — de trekkergegevens).
  var vandaag = new Date().toISOString().slice(0,10);
  var over14 = new Date(Date.now() + 14*24*3600*1000).toISOString().slice(0,10);
  var f = factuur || {
    nummer: voorstelNummer,
    datum: vandaag,
    vervaldatum: over14,
    status: 'concept',
    klant: {}, machine: {}, machines: [], regels: [],
    prijsType: 'marge', aanbetaling: 0, aanbetalingVervalt: '',
    levering: '', opmerking: '', garantie: true, bank: bank || {},
    overeenkomst: {}
  };
  if (!factuur && typeof vanOvereenkomst !== 'undefined' && vanOvereenkomst) {
    // Factuur gestart vanuit een koopovereenkomst: alles overnemen en de
    // verwijzing naar de overeenkomst alvast invullen.
    f.klant = vanOvereenkomst.klant || {};
    f.machines = documentMachines(vanOvereenkomst);
    f.machine = f.machines[0] || {};
    f.regels = vanOvereenkomst.regels || [];
    f.prijsType = vanOvereenkomst.prijsType || 'marge';
    f.aanbetaling = vanOvereenkomst.aanbetaling || 0;
    f.aanbetalingVervalt = vanOvereenkomst.aanbetalingVervalt || '';
    f.levering = vanOvereenkomst.levering || '';
    f.bank = vanOvereenkomst.bank || bank || {};
    f.overeenkomst = { nummer: vanOvereenkomst.nummer, datum: vanOvereenkomst.datum };
  } else if (!factuur && trekker) {
    f.machines = [{
      naam: (trekker.merk + ' ' + trekker.model).trim(),
      bouwjaar: trekker.bouwjaar || '', uren: trekker.uren || '',
      pk: trekker.pk || '', transmissie: trekker.transmissie || '',
      serienummer: '', kenteken: ''
    }];
    f.machine = f.machines[0];
    f.prijsType = (trekker.prijsType === 'btw' || trekker.prijsType === 'netto') ? trekker.prijsType : 'marge';
    f.regels = [{ omschrijving: 'Verkoopprijs ' + trekker.merk + ' ' + trekker.model + ' (rijklaar geleverd)', bedrag: trekker.prijs || 0 }];
  }
  var machines = documentMachines(f);
  if (!machines.length) machines = [{ naam:'', bouwjaar:'', uren:'', pk:'', transmissie:'', serienummer:'', kenteken:'' }];
  var fb = f.bank || bank || {};
  // Bedrag netjes tonen in het invulveld: 29500.5 -> "29500,50"
  function invoerBedrag(n){
    n = Number(n || 0);
    if (!n) return '';
    return (Math.round(n * 100) / 100).toFixed(2).replace('.', ',');
  }
  var trekkerKeuze = (trekkers || []).map(function(t){
    return {
      id: t.id,
      naam: (t.merk + ' ' + t.model).trim(),
      bouwjaar: t.bouwjaar || '',
      uren: t.uren || '',
      pk: t.pk || '',
      transmissie: t.transmissie || '',
      prijs: t.prijs || 0,
      prijsType: (t.prijsType === 'btw' || t.prijsType === 'netto') ? t.prijsType : 'marge',
      label: t.merk + ' ' + t.model + ' (' + (t.bouwjaar || '—') + ') — ' + euro(t.prijs)
    };
  });
%>
<div class="topbar">
  <div><h1><%= factuur ? 'Factuur bewerken' : 'Nieuwe factuur' %></h1>
    <div class="sub"><a href="/uadmin/facturen" style="color:var(--muted)">← Terug naar facturen</a></div></div>
  <% if (factuur) { %>
    <a class="btn btn-fill" href="/uadmin/facturen/<%= factuur.id %>/print" target="_blank">Bekijk / opslaan als PDF ↗</a>
  <% } %>
</div>

<% if (typeof opgeslagen !== 'undefined' && opgeslagen) { %>
  <div class="melding ok">Factuur opgeslagen. Klik rechtsboven op <b>"Bekijk / opslaan als PDF"</b> voor de opgemaakte factuur.</div>
<% } %>

<form method="post" action="/uadmin/facturen<%= factuur ? '/'+factuur.id : '' %>">

<div class="panel" style="padding:28px;margin-bottom:20px">
  <h3 style="font-family:var(--display);font-weight:600;margin-bottom:18px">Factuurgegevens</h3>
  <div class="formgrid">
    <div class="field"><label>Factuurnummer</label><input name="nummer" value="<%= f.nummer %>" required></div>
    <div class="field"><label>Status</label>
      <select name="status">
        <option value="concept" <%= f.status==='concept'?'selected':'' %>>Concept</option>
        <option value="verstuurd" <%= f.status==='verstuurd'?'selected':'' %>>Verstuurd</option>
        <option value="betaald" <%= f.status==='betaald'?'selected':'' %>>Betaald</option>
      </select>
    </div>
    <div class="field"><label>Factuurdatum</label><input type="date" name="datum" value="<%= f.datum %>" required></div>
    <div class="field"><label>Vervaldatum</label><input type="date" name="vervaldatum" value="<%= f.vervaldatum %>"><div class="hint">Uiterste betaaldatum (van het volledige bedrag of het restant).</div></div>
    <div class="field"><label>Koopovereenkomst-nummer — optioneel</label><input name="ov_nummer" value="<%= (f.overeenkomst && f.overeenkomst.nummer) || '' %>" placeholder="Bijv. AGR-KO-2026-0001"><div class="hint">Vul je dit in, dan vermeldt de factuur dat hij voortvloeit uit die koopovereenkomst en dat de voorwaarden en garanties daarvan van toepassing zijn.</div></div>
    <div class="field"><label>Datum koopovereenkomst</label><input type="date" name="ov_datum" value="<%= (f.overeenkomst && f.overeenkomst.datum) || '' %>"></div>
  </div>
</div>

<div class="panel" style="padding:28px;margin-bottom:20px">
  <h3 style="font-family:var(--display);font-weight:600;margin-bottom:18px">Klant (factuuradres)</h3>
  <div class="formgrid">
    <div class="field"><label>Naam</label><input name="klant_naam" value="<%= f.klant.naam || '' %>" placeholder="Bijv. J. van den Berg" required></div>
    <div class="field"><label>Bedrijfsnaam — optioneel</label><input name="klant_bedrijf" value="<%= f.klant.bedrijf || '' %>" placeholder="Bijv. Maatschap Van den Berg"></div>
    <div class="field"><label>Adres</label><input name="klant_adres" value="<%= f.klant.adres || '' %>" placeholder="Straat en huisnummer"></div>
    <div class="field"><label>Postcode en plaats</label><input name="klant_postcodeplaats" value="<%= f.klant.postcodePlaats || '' %>" placeholder="1234 AB Plaatsnaam"></div>
    <div class="field"><label>Land — optioneel</label><input name="klant_land" value="<%= f.klant.land || '' %>" placeholder="Nederland / België / Duitsland"></div>
    <div class="field"><label>E-mail — optioneel</label><input name="klant_email" value="<%= f.klant.email || '' %>"></div>
    <div class="field"><label>Telefoon — optioneel</label><input name="klant_telefoon" value="<%= f.klant.telefoon || '' %>"></div>
    <div class="field"><label>KvK-nummer klant — optioneel</label><input name="klant_kvk" value="<%= f.klant.kvk || '' %>"></div>
    <div class="field"><label>BTW-nummer klant — optioneel</label><input name="klant_btw" value="<%= f.klant.btw || '' %>"><div class="hint">Handig bij zakelijke klanten of levering binnen de EU.</div></div>
  </div>
</div>

<div class="panel" style="padding:28px;margin-bottom:20px">
  <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;margin-bottom:10px">
    <div>
      <h3 style="font-family:var(--display);font-weight:600;margin:0 0 6px">Machines</h3>
      <div class="hint">Je kunt één of meerdere trekkers op dezelfde factuur zetten. Kies uit het aanbod of vul handmatig in.</div>
    </div>
  </div>
  <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:18px;padding:14px 16px;background:#f7f5f0;border:1px solid var(--line);border-radius:12px">
    <b style="font-size:.9rem">Trekker uit aanbod toevoegen:</b>
    <select id="trekkerKiezer" style="border:1px solid var(--line);border-radius:8px;padding:9px 12px;font-family:inherit;font-size:.9rem;background:#fff;min-width:260px">
      <option value="">— kies een trekker —</option>
      <% trekkerKeuze.forEach(function(t){ %>
        <option value="<%= t.id %>"><%= t.label %></option>
      <% }) %>
    </select>
    <button class="btn btn-out btn-sm" type="button" id="trekkerErbij">+ Toevoegen aan factuur</button>
  </div>
  <div id="machines">
    <% machines.forEach(function(m, idx){ %>
      <div class="machine-blok" style="border:1px solid var(--line);border-radius:12px;padding:18px;margin-bottom:12px;background:#fff">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
          <b style="font-size:.92rem">Machine <span class="machine-nr"><%= idx + 1 %></span></b>
          <button type="button" class="btn btn-danger btn-sm machine-weg" title="Machine verwijderen">×</button>
        </div>
        <div class="formgrid">
          <div class="field"><label>Merk en model</label><input name="machine_naam" value="<%= m.naam || '' %>" placeholder="Bijv. Fendt 724 Vario"></div>
          <div class="field"><label>Bouwjaar</label><input name="machine_bouwjaar" value="<%= m.bouwjaar || '' %>" placeholder="2019"></div>
          <div class="field"><label>Draaiuren</label><input name="machine_uren" value="<%= m.uren || '' %>" placeholder="3250"></div>
          <div class="field"><label>Vermogen (pk)</label><input name="machine_pk" value="<%= m.pk || '' %>" placeholder="240"></div>
          <div class="field"><label>Transmissie</label><input name="machine_transmissie" value="<%= m.transmissie || '' %>" placeholder="Vario / Powershift …"></div>
          <div class="field"><label>Serie-/chassisnummer — optioneel</label><input name="machine_serienummer" value="<%= m.serienummer || '' %>"></div>
          <div class="field"><label>Kenteken — optioneel</label><input name="machine_kenteken" value="<%= m.kenteken || '' %>"></div>
        </div>
      </div>
    <% }) %>
  </div>
  <button type="button" class="btn btn-out btn-sm" id="machineErbij">+ Lege machine toevoegen</button>
</div>

<div class="panel" style="padding:28px;margin-bottom:20px">
  <h3 style="font-family:var(--display);font-weight:600;margin-bottom:6px">Specificatie (factuurregels)</h3>
  <div class="hint" style="margin-bottom:16px">Per trekker komt er automatisch een regel bij. Een aftrek (bijv. inruil of korting) vul je in als <b>negatief</b> bedrag, bijv. <code>-12500</code>. Bedragen mogen met of zonder punten/komma's: <code>29500</code>, <code>29.500</code> of <code>29500,50</code>.</div>
  <div id="regels">
    <% (f.regels.length ? f.regels : [{omschrijving:'',bedrag:''}]).forEach(function(r){ %>
      <div class="regel" style="display:flex;gap:12px;margin-bottom:10px">
        <input name="regel_omschrijving" value="<%= r.omschrijving %>" placeholder="Omschrijving — bijv. Verkoopprijs Fendt 724 Vario (rijklaar geleverd)" style="flex:1;border:1px solid var(--line);border-radius:9px;padding:12px 13px;font-family:var(--body);font-size:.94rem">
        <input name="regel_bedrag" value="<%= typeof r.bedrag === 'number' ? invoerBedrag(r.bedrag) : r.bedrag %>" placeholder="Bedrag in €" style="width:170px;border:1px solid var(--line);border-radius:9px;padding:12px 13px;font-family:var(--body);font-size:.94rem;text-align:right">
        <button type="button" class="btn btn-danger btn-sm regel-weg" title="Regel verwijderen">×</button>
      </div>
    <% }) %>
  </div>
  <button type="button" class="btn btn-out btn-sm" id="regelErbij">+ Regel toevoegen</button>

  <div class="formgrid" style="margin-top:22px">
    <div class="field full">
      <label>Prijsregeling</label>
      <select name="prijsType" id="prijsType">
        <option value="marge" <%= (!f.prijsType || f.prijsType==='marge')?'selected':'' %>>Margeregeling — bedragen zijn totaalprijzen, BTW niet apart vermeld (gebruikte machines)</option>
        <option value="btw" <%= f.prijsType==='btw'?'selected':'' %>>BTW-regeling — bedragen zijn excl. BTW; 21% BTW wordt apart op de factuur gezet</option>
        <option value="netto" <%= f.prijsType==='netto'?'selected':'' %>>Netto — geen Nederlandse BTW (bijv. Belgische/EU-klanten)</option>
      </select>
      <div class="hint">
        <b>BTW-regeling</b>: 21% NL-BTW apart. <b>Margeregeling</b>: BTW zit in de prijs. <b>Netto</b>: geen Nederlandse BTW — geschikt als de koper in België/EU geen NL-belasting betaalt (vul bij voorkeur het BTW-nummer van de koper in).
      </div>
    </div>
    <div class="field"><label>Aanbetaling — optioneel</label><input name="aanbetaling" value="<%= invoerBedrag(f.aanbetaling) %>" placeholder="Bijv. 5000"><div class="hint">Vul je hier een bedrag in, dan toont de factuur een betaalschema: aanbetaling + restant bij levering.</div></div>
    <div class="field"><label>Vervaldatum aanbetaling</label><input type="date" name="aanbetaling_vervalt" value="<%= f.aanbetalingVervalt %>"></div>
  </div>
</div>

<div class="panel" style="padding:28px;margin-bottom:20px">
  <h3 style="font-family:var(--display);font-weight:600;margin-bottom:18px">Levering, garantie en betaling</h3>
  <div class="formgrid">
    <div class="field full"><label>Levering — optioneel</label><textarea name="levering" rows="2" placeholder="Bijv.: De trekker wordt rijklaar en gratis geleverd op het adres van koper."><%= f.levering %></textarea></div>
    <div class="field full">
      <label>Garantie op de factuur</label>
      <select name="garantie">
        <option value="aan" <%= f.garantie!==false?'selected':'' %>>Agroria-garantie tonen — 12 maanden volledige garantie + 6 maanden geld-terug bij motorisch defect</option>
        <option value="uit" <%= f.garantie===false?'selected':'' %>>Geen garantieblok op deze factuur</option>
      </select>
      <div class="hint">De volledige garantievoorwaarden staan automatisch en netjes opgemaakt op de factuur zelf.</div>
    </div>
    <div class="field full"><label>Eigen opmerking op de factuur — optioneel</label><textarea name="opmerking" rows="2" placeholder="Bijv.: Zoals besproken op het erf d.d. 12-07-2026."><%= f.opmerking %></textarea></div>
    <div class="field"><label>IBAN</label><input name="bank_iban" value="<%= fb.iban || '' %>" placeholder="NL00 BANK 0123 4567 89"></div>
    <div class="field"><label>BIC — optioneel</label><input name="bank_bic" value="<%= fb.bic || '' %>" placeholder="INGBNL2A"></div>
    <div class="field"><label>Ten name van</label><input name="bank_tnv" value="<%= fb.tnv || '' %>" placeholder="Agroria Landbouwvoertuigen"><div class="hint">De bankgegevens worden onthouden voor de volgende factuur.</div></div>
  </div>
</div>

<div class="formactions" style="margin-bottom:34px">
  <button class="btn btn-fill" type="submit"><%= factuur ? 'Wijzigingen opslaan' : 'Factuur opslaan' %></button>
  <a class="btn btn-out" href="/uadmin/facturen">Annuleren</a>
</div>
</form>

<script>
  window.__AGRORIA_TREKKERS__ = <%- safeJsonLd(trekkerKeuze) %>;
  window.__AGRORIA_REGEL_PREFIX__ = 'Verkoopprijs';
</script>
<script>
  (function(){
    function nummerMachines(){
      var blokken = document.querySelectorAll('#machines .machine-blok');
      blokken.forEach(function(blok, i){
        var nr = blok.querySelector('.machine-nr');
        if (nr) nr.textContent = String(i + 1);
      });
    }

    function leegMachineBlok(){
      var houder = document.getElementById('machines');
      var eerste = houder.querySelector('.machine-blok');
      var kopie = eerste.cloneNode(true);
      kopie.querySelectorAll('input').forEach(function(i){ i.value = ''; });
      return kopie;
    }

    function vulMachineBlok(blok, data){
      var map = {
        machine_naam: data.naam || '',
        machine_bouwjaar: data.bouwjaar || '',
        machine_uren: data.uren || '',
        machine_pk: data.pk || '',
        machine_transmissie: data.transmissie || '',
        machine_serienummer: data.serienummer || '',
        machine_kenteken: data.kenteken || ''
      };
      Object.keys(map).forEach(function(naam){
        var veld = blok.querySelector('input[name="' + naam + '"]');
        if (veld) veld.value = map[naam];
      });
    }

    function voegRegelToe(omschrijving, bedrag){
      var houder = document.getElementById('regels');
      var eerste = houder.querySelector('.regel');
      var kopie = eerste.cloneNode(true);
      var velden = kopie.querySelectorAll('input');
      velden[0].value = omschrijving || '';
      velden[1].value = bedrag || '';
      // Als de enige bestaande regel nog leeg is, vul die in plaats van een extra regel.
      var bestaande = houder.querySelectorAll('.regel');
      if (bestaande.length === 1) {
        var b0 = bestaande[0].querySelectorAll('input');
        if (!b0[0].value && !b0[1].value) {
          b0[0].value = omschrijving || '';
          b0[1].value = bedrag || '';
          return;
        }
      }
      houder.appendChild(kopie);
    }

    function bedragVoorInvoer(n){
      n = Number(n || 0);
      if (!n) return '';
      return (Math.round(n * 100) / 100).toFixed(2).replace('.', ',');
    }

    var wasLeeg = (function(){
      var naam = document.querySelector('#machines input[name="machine_naam"]');
      return !naam || !naam.value.trim();
    })();

    document.getElementById('machineErbij').addEventListener('click', function(){
      document.getElementById('machines').appendChild(leegMachineBlok());
      nummerMachines();
    });

    document.getElementById('machines').addEventListener('click', function(e){
      var knop = e.target.closest('.machine-weg');
      if (!knop) return;
      var houder = document.getElementById('machines');
      var blokken = houder.querySelectorAll('.machine-blok');
      if (blokken.length <= 1) {
        blokken[0].querySelectorAll('input').forEach(function(i){ i.value = ''; });
        return;
      }
      knop.closest('.machine-blok').remove();
      nummerMachines();
    });

    document.getElementById('trekkerErbij').addEventListener('click', function(){
      var keuze = document.getElementById('trekkerKiezer').value;
      if (!keuze) return;
      var t = (window.__AGRORIA_TREKKERS__ || []).find(function(x){ return x.id === keuze; });
      if (!t) return;
      var houder = document.getElementById('machines');
      var blokken = houder.querySelectorAll('.machine-blok');
      var doel = null;
      // Vul een leeg eerste blok, anders voeg een nieuw blok toe.
      if (blokken.length === 1) {
        var naamVeld = blokken[0].querySelector('input[name="machine_naam"]');
        if (naamVeld && !naamVeld.value.trim()) doel = blokken[0];
      }
      if (!doel) {
        doel = leegMachineBlok();
        houder.appendChild(doel);
      }
      vulMachineBlok(doel, t);
      nummerMachines();
      voegRegelToe(
        (window.__AGRORIA_REGEL_PREFIX__ || 'Verkoopprijs') + ' ' + t.naam + ' (rijklaar geleverd)',
        bedragVoorInvoer(t.prijs)
      );
      // Prijsregeling alleen overnemen bij de eerste machine.
      var prijsType = document.getElementById('prijsType');
      if (prijsType && wasLeeg) prijsType.value = t.prijsType || 'marge';
      wasLeeg = false;
      document.getElementById('trekkerKiezer').value = '';
    });

    // Factuurregels toevoegen/verwijderen
    var houder = document.getElementById('regels');
    document.getElementById('regelErbij').addEventListener('click', function(){
      var eerste = houder.querySelector('.regel');
      var kopie = eerste.cloneNode(true);
      kopie.querySelectorAll('input').forEach(function(i){ i.value=''; });
      houder.appendChild(kopie);
    });
    houder.addEventListener('click', function(e){
      var knop = e.target.closest('.regel-weg');
      if (!knop) return;
      var regels = houder.querySelectorAll('.regel');
      if (regels.length <= 1) {
        regels[0].querySelectorAll('input').forEach(function(i){ i.value=''; });
        return;
      }
      knop.closest('.regel').remove();
    });
  })();
</script>
<%- include('_foot') %>
